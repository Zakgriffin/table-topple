{
    "compilerOptions": {
        "strict": true,
        "sourceMap": true,
        "module": "ESNext",
        "target": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "noUnusedLocals": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    }
}
